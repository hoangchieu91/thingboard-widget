        "jsScript" : "var temp = msg.temperature;\nif (temp === undefined || temp === null) {\n    return {result: false};\n}\nfunction pick(vals, defVal) {\n    for (var i = 0; i < vals.length; i++) {\n        var v = parseFloat(vals[i]);\n        if (!isNaN(v)) return v;\n    }\n    return defVal;\n}\nvar LL = pick([msg.alarm_LL, metadata.shared_alarm_LL, metadata.shared_LL, metadata.ss_alarm_LL, metadata.ss_LL, metadata.alarm_LL], 5.0);\nvar L  = pick([msg.alarm_L,  metadata.shared_alarm_L,  metadata.shared_L,  metadata.ss_alarm_L,  metadata.ss_L,  metadata.alarm_L], 10.0);\nvar H  = pick([msg.alarm_H,  metadata.shared_alarm_H,  metadata.shared_H,  metadata.ss_alarm_H,  metadata.ss_H,  metadata.alarm_H], 38.0);\nvar HH = pick([msg.alarm_HH, metadata.shared_alarm_HH, metadata.shared_HH, metadata.ss_alarm_HH, metadata.ss_HH, metadata.alarm_HH], 45.0);\n\nmsg.alarm_LL = LL;\nmsg.alarm_L  = L;\nmsg.alarm_H  = H;\nmsg.alarm_HH = HH;\nmsg.alarmType = null;\nmsg.alarmSeverity = null;\n\nif (temp >= HH) {\n    msg.alarmType = 'TEMP_HIGH_HIGH (Quá Nóng Khẩn Cấp)';\n    msg.alarmSeverity = 'CRITICAL';\n} else if (temp <= LL) {\n    msg.alarmType = 'TEMP_LOW_LOW (Quá Lạnh Khẩn Cấp)';\n    msg.alarmSeverity = 'CRITICAL';\n} else if (temp >= H && temp < (HH - 0.5)) {\n    msg.alarmType = 'TEMP_HIGH (Cảnh Báo Nóng)';\n    msg.alarmSeverity = 'WARNING';\n} else if (temp <= L && temp > (LL + 0.5)) {\n    msg.alarmType = 'TEMP_LOW (Cảnh Báo Lạnh)';\n    msg.alarmSeverity = 'WARNING';\n}\nreturn {msg: msg, metadata: metadata, msgType: msgType};"
